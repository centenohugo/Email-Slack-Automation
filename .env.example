# Copia este archivo como  .env  y rellena tus valores.
#   Windows:  copy .env.example .env
# El archivo .env NUNCA se sube al repositorio (esta en .gitignore).

# --- Obligatorio ------------------------------------------------------------
# Clave interna de Flask. Pon cualquier texto largo y aleatorio.
SECRET_KEY=cambia-esto-por-un-texto-aleatorio-largo

# Dominio de correo de tu empresa. El login "jdoe" se convierte en jdoe@...
EMAIL_DOMAIN=@example.com


# --- Tu site ----------------------------------------------------------------
# Nombre corto que se ve en la cabecera de la web.
SITE_NAME=RME

# Firma que aparece al final de los correos y mensajes de Slack.
SIGNATURE=Equipo de RME-Trainings

# Edificios que se tienen en cuenta, separados por comas. Vacio = todos.
BUILDINGS=

# Enlace del panel de donde se descarga el CSV de formacion.
# Se muestra como boton en la pantalla inicial de la app.
REPORT_URL=

# Cursos que caducan en menos de estos dias (incluye los ya caducados).
DAYS_THRESHOLD=21

# Turnos numericos con SRMET asignado: 1..CREW_COUNT
CREW_COUNT=12

# Equipos con nombre propio que tambien tienen SRMET, separados por comas.
NAMED_CREWS=


# --- Opcional ---------------------------------------------------------------
# Token del bot de Slack. Dejalo vacio si solo vas a enviar por correo.
# Scopes necesarios: users:read, users:read.email, chat:write, im:write
SLACK_BOT_TOKEN=

# Correo al que llegan los envios en modo test.
# Si lo dejas vacio se usa <tu-usuario-de-windows>@EMAIL_DOMAIN
TEST_EMAIL=

# Fichero de equipos. Se genera con:  python build_teams.py <rota.xlsm>
TEAMS_FILE=sample/Teams.xlsx

# Puerto en el que arranca la app.
PORT=5005
