# --- Credenciales -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials*
secrets*

# --- Datos con informacion personal --------------------------
# Fichero de equipos: contiene nombres y logins reales.
# Se regenera con:  python build_teams.py <rota.xlsm>
sample/Teams.xlsx
Teams.xlsx

# Informes de formacion descargados del panel.
sample/Training_Report*.csv
Training_Report*.csv

# Rotas / calendarios y cualquier CSV o Excel suelto en la raiz.
*.xlsm
/*.csv
/*.xlsx

# Carpeta temporal donde se suben los ficheros desde la web.
uploads/

# --- Python --------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/

